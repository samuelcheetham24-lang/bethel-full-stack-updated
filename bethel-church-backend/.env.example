# Copy this file to ".env" and fill in your own values.
# Never share your real .env file or commit it anywhere public.

PORT=3000

# Used to sign admin login tokens. Make this a long, random string.
JWT_SECRET=change-this-to-a-long-random-string

# How long an admin login stays valid before needing to log in again.
JWT_EXPIRES_IN=7d

# --- Paystack (for online giving) ---
# Get this from your Paystack dashboard: Settings -> API Keys & Webhooks.
# Start with your TEST secret key (starts with sk_test_) while trying
# this out — it doesn't move real money. Switch to your LIVE key
# (starts with sk_live_) only once you're ready to accept real giving.
PAYSTACK_SECRET_KEY=sk_test_your_test_secret_key_here
